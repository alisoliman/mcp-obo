FROM ghcr.io/astral-sh/uv:0.11.29 AS uv
FROM python:3.13-slim

COPY --from=uv /uv /uvx /bin/

WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY src ./src

USER 65532:65532
EXPOSE 8000
# Module form, not `python src/server.py`. Running the file directly puts
# /app/src on sys.path instead of /app, and the server imports its siblings as
# `src.obo` / `src.databricks` so the tests and the image resolve them the same
# way.
CMD ["python", "-m", "src.server"]
