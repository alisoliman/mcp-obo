FROM ghcr.io/astral-sh/uv:0.12.1 AS uv
FROM python:3.13-slim

COPY --from=uv /uv /uvx /bin/

WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY src/__init__.py ./src/
COPY src/shared ./src/shared
COPY src/mcp_server ./src/mcp_server

USER 65532:65532
EXPOSE 8000
# Module form, not `python src/mcp_server/server.py`. Running the file directly
# puts /app/src/mcp_server on sys.path instead of /app, and the server imports
# its siblings as `src.mcp_server.obo` / `src.shared.modes` so the tests and the
# image resolve them the same way.
CMD ["python", "-m", "src.mcp_server"]
