...@_theme

# What runs where, and which links carry the user's identity.
# Sequence and step order live in token-flow.d2, not here.
# Render: d2 docs/architecture.d2 docs/architecture.svg

direction: down

user: {
  label: "Signed-in user"
  class: actor
}

aks: {
  label: "AKS · workload identity"
  label.near: top-left
  class: group

  ingress: {
    label: "ingress-nginx\nTLS termination"
    class: node
  }
  chat: {
    label: "order-agent-chat\nAgent Framework + React"
    class: node
  }
  mcp: {
    label: "fastmcp-orders\nMCP resource server"
    class: node
  }
}

foundry: {
  label: "Microsoft Foundry\ngpt-5.6-terra"
  class: node
}

entra: {
  label: "Microsoft Entra ID"
  label.near: top-right
  class: group

  chatapp: {
    label: "chat app\nregistration"
    class: identity
  }
  serverapp: {
    label: "server app\nregistration"
    class: identity
  }
}

graph: {
  label: "Microsoft Graph\nGET /me"
  class: identity
}

user -> aks.ingress: "HTTPS" { class: plain }
aks.ingress -> aks.chat: "/" { class: plain }
aks.chat -> foundry: "inference" { class: plain }
aks.chat -> entra.chatapp: "sign-in\nauth code + PKCE" { class: carries }
# The chat pod has no in-cluster route to the MCP server: MCP_ENDPOINT is the
# public hostname, so its own tool calls leave and come back through ingress.
aks.chat -> aks.ingress: "tool call" { class: carries }
aks.ingress -> aks.mcp: "/mcp\nuser's token as Bearer" { class: carries }
aks.mcp -> entra.serverapp: "on-behalf-of\nexchange" { class: carries }
aks.mcp -> graph: "user's\nGraph token" { class: carries }
