...@_theme

# Order data needs a user's token and a pod's identity; neither alone reaches it.
# Render: d2 docs/trust-boundaries.d2 docs/trust-boundaries.svg

direction: down

creds: {
  label: "Credentials in this system"
  label.near: top-left
  class: group

  chatwi: {
    label: "Chat pod\nworkload identity"
    class: node
  }
  usertok: {
    label: "User's delegated token\nminted only by sign-in"
    class: identity
  }
  mcpwi: {
    label: "MCP pod\nworkload identity"
    class: node
  }
}

foundry: {
  label: "Foundry inference"
  class: node
}

obo: {
  label: "On-behalf-of exchange"
  class: identity
}

orders: {
  label: "The caller's orders"
  class: node
}

creds.chatwi -> foundry: "alone, this is enough" { class: plain }
creds.chatwi -> orders: "no application permission" { class: blocked }
creds.usertok -> obo: "user assertion" { class: carries }
creds.mcpwi -> obo: "client assertion" { class: plain }
creds.mcpwi -> orders: "/me means nothing\nwithout a caller" { class: blocked }
obo -> orders: "Graph /me names the caller" { class: carries }
