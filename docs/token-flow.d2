...@_theme

# The delegated on-behalf-of token flow, one message at a time.
# Render: d2 docs/token-flow.d2 docs/token-flow.svg

shape: sequence_diagram

user: {
  label: "User"
  class: actor
}
foundry: {
  label: "Foundry\ngpt-5.6-terra"
  class: node
}
chat: {
  label: "order-agent-chat\nconfidential client"
  class: node
}
entra: {
  label: "Microsoft\nEntra ID"
  class: identity
}
mcp: {
  label: "fastmcp-orders\nresource server"
  class: node
}
graph: {
  label: "Microsoft\nGraph"
  class: identity
}

signin: {
  label: "Sign in — the only step involving a human"
  class: section

  user -> chat: "GET /login" { class: plain }
  chat -> entra: "auth code + PKCE\nclient assertion = pod identity" { class: carries }
  entra -> chat: "delegated token\naud = api://<server-app>\nscp = Mcp.Tools.ReadWrite" { class: carries }
  chat -> chat: "cached for\nthis session" { class: carries }
}

ask: {
  label: "Every subsequent question"
  class: section

  user -> chat: "\"What orders do I have?\"" { class: plain }
  chat -> foundry: "inference — workload identity" { class: plain }
  foundry -> chat: "tool call: list_orders" { class: plain }
}

obo: {
  label: "The on-behalf-of exchange"
  class: section

  chat -> mcp: "POST /mcp\nBearer <user token>" { class: carries }
  mcp -> mcp: "verify\niss, aud, scp" { class: carries }
  mcp -> entra: "OBO grant\nuser + client assertion" { class: carries }
  entra -> mcp: "Graph token, still the user" { class: carries }
  mcp -> graph: "GET /me" { class: carries }
  graph -> mcp: "object id, displayName" { class: carries }
  mcp -> mcp: "partition by\nobject id" { class: carries }
}

answer: {
  label: "Back to the browser"
  class: section

  mcp -> chat: "orders owned by this user only" { class: plain }
  chat -> user: "streamed answer, never the token" { class: plain }
}
