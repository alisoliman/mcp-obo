...@_theme

# The second on-behalf-of exchange: the same user token, a different resource.
# Render: d2 docs/databricks-obo.d2 docs/databricks-obo.svg

shape: sequence_diagram

chat: {
  label: "order-agent-chat\nconfidential client"
  class: node
}
mcp: {
  label: "fastmcp-orders\nresource server"
  class: node
}
entra: {
  label: "Microsoft\nEntra ID"
  class: identity
}
warehouse: {
  label: "Databricks\nSQL warehouse"
  class: node
}
uc: {
  label: "Unity\nCatalog"
  class: identity
}

arrive: {
  label: "The same token the order tools get"
  class: section

  chat -> mcp: "databricks_query_orders\nBearer <user's token>" { class: carries }
  mcp -> mcp: "verify\niss, aud, scp" { class: carries }
}

exchange: {
  label: "Only the scope is different"
  class: section

  mcp -> entra: "OBO grant\nscope 2ff814a6-…/.default" { class: carries }
  entra -> mcp: "Databricks token, still the user" { class: carries }
}

query: {
  label: "Where the authorization actually happens"
  class: section

  mcp -> warehouse: "POST /api/2.0/sql/statements\nfixed SQL + bound parameters" { class: carries }
  warehouse -> uc: "who is current_user()?" { class: carries }
  uc -> uc: "row filter +\ncolumn mask" { class: carries }
  uc -> warehouse: "caller's rows, email masked" { class: plain }
  warehouse -> mcp: "already-scoped result set" { class: plain }
  mcp -> chat: "never had anyone else's rows" { class: plain }
}
