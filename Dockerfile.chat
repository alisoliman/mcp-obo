FROM node:22-alpine AS frontend

WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
RUN npm run build

FROM ghcr.io/astral-sh/uv:0.13.6 AS uv
FROM python:3.13-slim

COPY --from=uv /uv /uvx /bin/

WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY src/__init__.py ./src/
COPY src/shared ./src/shared
COPY src/chat_app ./src/chat_app
COPY --from=frontend /frontend/dist ./frontend/dist

USER 65532:65532
EXPOSE 8001
# Only this workload's tree is copied, so an import that reaches across into
# `src.mcp_server` fails the build rather than quietly shipping the resource
# server inside the client's image.
#
# Module form, not `python src/chat_app/app.py`. Running the file directly puts
# /app/src/chat_app on sys.path instead of /app, and the app imports its
# siblings as `src.chat_app.sessions` / `src.shared.tools`.
CMD ["python", "-m", "src.chat_app"]
